# Local development environment for docker-compose (copy to .env).
#
# These are THROWAWAY dev credentials for a MySQL container bound to 127.0.0.1
# — NOT production secrets. Real production credentials live only in
# config/config.php above the webroot (gitignored). See SECURITY.md SEC-22.
#
# docker-compose reads .env automatically; run.sh copies this file to .env on
# first start if one does not exist.

MYSQL_ROOT_PASSWORD=rootpw
DB_NAME=stjosephs
DB_USER=stjosephs
DB_PASS=stjosephs_pw
