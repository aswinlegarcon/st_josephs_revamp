# Root hardening for the public webroot (PHASES.md S4, SECURITY.md SEC-12/13/20).
# All directives are wrapped in <IfModule> so a host lacking a module degrades
# safely rather than 500-ing.

# No directory listings.
Options -Indexes

# Block dotfiles (.git, .env, .htpasswd…) but allow ACME/SSL issuance.
RedirectMatch 404 "^/\.(?!well-known/)"

# Block source/backup/dump/archive artifacts that must never be web-served.
<FilesMatch "\.(sql|bak|old|zip|tar|gz|tgz|log|md|lock|swp|dump|ini|sh)$">
  Require all denied
</FilesMatch>

# Security response headers for every page/asset.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Enable once the site is HTTPS-only (safe to leave; ignored over HTTP):
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── Performance: compression + caching (PHASES.md F1) ────────────────────────
# Gzip text responses (~70% smaller HTML/CSS/JS/SVG/JSON).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/x-javascript text/javascript \
    application/json image/svg+xml application/xml
</IfModule>

# Cache static assets hard (they are versioned with ?v=SJ_ASSET_VER, so a new
# deploy changes the URL). HTML is never cached so content edits appear at once.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/gif               "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  # Long-lived, immutable caching for the versioned asset folders.
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|gif|ico|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Never cache HTML (PHP output) — edits must show immediately.
  <FilesMatch "\.php$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
